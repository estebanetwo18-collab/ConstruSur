# ---------------------------------------------------------------
# ConstruSur — variables de entorno
# Copie este archivo como .env.local para desarrollo.
# En Vercel: Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# URL pública final del sitio (canonical, Open Graph, sitemap, schema).
# Ej.: https://www.construsur.cr  (sin barra final)
NEXT_PUBLIC_SITE_URL=

# --- Correo (Resend) -------------------------------------------
# Si falta alguna de las tres, /api/lead funciona en "modo dev":
# responde OK y escribe el lead en la consola (no envía correos).
RESEND_API_KEY=
# Destinatario(s) de los leads. Varios separados por coma.
LEAD_TO_EMAIL=construsurdigital@gmail.com
# Remitente: debe ser de un dominio VERIFICADO en Resend.
# Ej.: ConstruSur <cotizaciones@construsur.cr>
LEAD_FROM_EMAIL=

# --- Agenda ----------------------------------------------------
# Opcional. Por defecto usa el Calendly del sitio actual.
NEXT_PUBLIC_CALENDLY_URL=

# --- Medición (opcionales: si están vacías no se carga nada) ---
# Google Analytics 4, ej.: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Meta Pixel, ej.: 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=
